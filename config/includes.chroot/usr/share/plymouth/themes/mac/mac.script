Window.SetBackgroundTopColor(0.035, 0.06, 0.12);
Window.SetBackgroundBottomColor(0.02, 0.025, 0.06);
title = Sprite();
title.SetImage(Text("MAC OS", 1, 1, 1));
title.SetPosition(Window.GetWidth() / 2 - title.GetWidth() / 2, Window.GetHeight() / 2 - title.GetHeight() / 2);
subtitle = Sprite();
subtitle.SetImage(Text("A new desktop experience", 0.55, 0.72, 0.95));
subtitle.SetPosition(Window.GetWidth() / 2 - subtitle.GetWidth() / 2, Window.GetHeight() / 2 + 42);
